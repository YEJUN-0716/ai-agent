# Python
__pycache__/
*.py[cod]
*.pyo
.env

# DART 캐시 (매일 자동 생성, 커밋 불필요)
dart_fund_cache.json
dart_corp_map.json

# 기타 런타임 생성 파일
*.log

# 개인 관심종목 (로컬 전용, 사용자마다 다름 — GH Actions 관리 대상 아님)
watchlist.json

# 가격 패널 캐시 (GitHub Actions cache로 공유, 커밋 대상 아님)
#
# data/ 를 통째로 무시하면 그 아래 analyst_log 를 되살릴 수 없다 — git 은
# 제외된 *디렉터리* 안의 파일을 다시 포함하지 못한다. 그래서 내용물만
# 무시하고(data/*) 예외를 낸다. analyst_log 는 성적표의 유일한 재료라
# 워크플로가 커밋해 돌려놔야 한다 (signal_log.json·ic_weights.json 과 같은 부류).
data/*
!data/analyst_log/
# 발행 이력도 마찬가지다 — 이 디렉터리가 러너를 못 넘기면 last_published_n
# 이 매번 None 을 돌려주고, 중복 발행 차단이 무력화돼 같은 판정이 매일
# 다시 발행된다 (워크플로가 커밋해 돌려놔야 하는 이유는 analyst_log 와 같다).
!data/publish_log/
# 15분봉 성적표의 재료. 점수(scalp_log)뿐 아니라 선행수익률(scalp_returns)도
# 남겨야 한다 — 15분봉은 60일이 지나면 사라져 다시 계산할 방법이 없다.
!data/scalp_log/
!data/scalp_returns/
# 워크포워드 측정 결과도 앱이 읽는 유일한 재료다 — 측정에 수 분 걸리므로
# 결과를 저장소에 남겨 어디서 열어도 같은 판정을 보게 한다.
!data/walkforward_result.json
.pytest_cache/

# 로컬 검증 실행이 만드는 빈 PIT DB — 실제 데이터는 워크플로가 생성·커밋한다
pit_fundamentals.db
krx_listing_cache.json
