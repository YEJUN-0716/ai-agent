# Secrets
.env
credentials.json
token.json

# Scratch space (keep the folder, ignore its contents)
.tmp/*
!.tmp/.gitkeep

# Generated data caches (예: analyze 실행 시 stock-analyzer 가격 패널 캐시가 생김)
# data/ 는 통째로 무시하되 생존 신호 한 줄만 예외.
# (`/data/` 로 폴더를 막으면 그 아래 예외는 git 이 아예 안 본다 — `/data/*` 여야 한다)
/data/*
!/data/heartbeat.json
/*.parquet

# 축구 앱 캐시 (openfootball JSON). 위 /data/* 는 루트만 막는다.
football/data/

# Playwright MCP 스크린샷 작업 폴더
.playwright-mcp/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.venv/
venv/
env/

# OS
.DS_Store
Thumbs.db
graphify-out/
